function secureTween(targetCFrame)
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not hrp or not humanoid or humanoid.Health <= 0 then return end
    
    local distance = (hrp.Position - targetCFrame.p).magnitude
    local speed = _G.FlySpeed or 250
    if speed <= 0 then speed = 250 end
    
    local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    if _G.NoClip or _G.AutoFarmLevel or _G.AutoBountyHunt or _G.AutoPrehistoricIsld then
        pcall(function() humanoid:ChangeState(11) end)
    end
    
    tween:Play()
    tween.Completed:Wait()
end

function equipWeapon(weaponClass)
    local character = LocalPlayer.Character
    if character then
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == weaponClass or (weaponClass == "Blox Fruit" and tool.ToolTip == "Blox Fruit")) then
                character.Humanoid:EquipTool(tool) return tool
            end
        end
        for _, tool in pairs(character:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == weaponClass or (weaponClass == "Blox Fruit" and tool.ToolTip == "Blox Fruit")) then return tool end
        end
    end
    return nil
end

