function checkTargetValidity(targetPlayer)
    if not targetPlayer or not targetPlayer:FindFirstChild("Data") or not LocalPlayer:FindFirstChild("Data") then return false end
    local myLvl = LocalPlayer.Data.Level.Value 
    local targetLvl = targetPlayer.Data.Level.Value 
    local char = targetPlayer.Character
    if targetLvl < _G.BountyConfig.MinLevelTarget then return false end
    if math.abs(myLvl - targetLvl) > _G.BountyConfig.MaxLevelDiff then return false end
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return false end
    if char:FindFirstChild("SafeZoneFFA") then return false end
    if _G.BountyConfig.SkipRaceV4Target and char:FindFirstChild("RaceV4Transformation") then return false end
    local tool = targetPlayer.Backpack:FindFirstChildOfClass("Tool") or char:FindFirstChildOfClass("Tool")
    if tool then
        local wName = string.lower(tool.Name)
        if _G.BountyConfig.SkipTigerWerewolf and (string.find(wName, "rex") or string.find(wName, "tiger") or string.find(wName, "werewolf")) then return false end
        if _G.BountyConfig.SkipDragon and string.find(wName, "dragon") then return false end
        if _G.BountyConfig.SkipKitsune and string.find(wName, "kitsune") then return false end
    end
    return true
end

function getBestBountyTarget()
    local nearest = nil 
    local shortestDist = math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and checkTargetValidity(p) then
            local myChar = LocalPlayer.Character
            local targetChar = p.Character
            if myChar and targetChar and myChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("HumanoidRootPart") then
                local dist = (myChar.HumanoidRootPart.Position - targetChar.HumanoidRootPart.Position).magnitude
                if dist < shortestDist then 
                    shortestDist = dist 
                    nearest = p 
                end
            end
        end
    end
    return nearest
end

function fireDynamicBountyCombo()
    local categories = {"Melee", "Sword", "Gun", "Blox Fruit"}
    local skillKeys = {Z = Enum.KeyCode.Z, X = Enum.KeyCode.X, C = Enum.KeyCode.C, V = Enum.KeyCode.V}
    for _, cat in ipairs(categories) do
        if not _G.AutoBountyHunt then break end
        local toolActive = equipWeapon(cat)
        if toolActive then
            pcall(function() toolActive:Activate() end)
            task.wait(0.05)
            for keyName, keyCode in pairs(skillKeys) do
                local configKey = cat.."_"..keyName
                if _G.SkillSettings[configKey] == true then
                    vim:SendKeyEvent(true, keyCode, false, game) 
                    task.wait(_G.BountyConfig.SkillHoldDelay)
                    vim:SendKeyEvent(false, keyCode, false, game) 
                    task.wait(0.08)
                end
            end
        end
    end
end

